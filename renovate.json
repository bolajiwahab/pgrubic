{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":maintainLockFilesWeekly",
    ":enablePreCommit"
  ],
  "description": "Schedule dependency updates weekly on Saturday",
  "schedule": ["on saturday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on saturday"]
  },
  // Wait a week after a release before proposing it. Updates without a release
  // timestamp, such as images on some registries, are not held back.
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  // Remove PR creation limits
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update images that pre-commit hooks run, pinned by digest, such as hadolint",
      "managerFilePatterns": [
        "/(^|/)\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9.-]*(?:/[a-z0-9._-]+)+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group docker dependencies",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "Dockerfile"
      ],
      "groupName": "docker updates",
      "groupSlug": "docker-updates"
    },
    {
      "description": "Group images that ship in the published image; their updates are fixes that trigger a release",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "Dockerfile"
      ],
      "matchDepNames": [
        "python"
      ],
      "groupName": "runtime images",
      "groupSlug": "runtime-images",
      "semanticCommitType": "fix",
      "semanticCommitScope": "docker"
    },
    {
      "description": "Group python development, documentation, and tooling dependencies; their updates do not trigger a release",
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python updates",
      "groupSlug": "python-updates",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group the dependencies installed with pgrubic; their updates are fixes that trigger a release",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "project.dependencies"
      ],
      "groupName": "runtime dependencies",
      "groupSlug": "runtime-dependencies",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group pre-commit hooks and the images they run",
      "matchFileNames": [
        ".pre-commit-config.yaml"
      ],
      "groupName": "pre-commit updates",
      "groupSlug": "pre-commit-updates"
    },
    {
      "description": "Group dependencies declared in GitHub Actions workflows",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions updates",
      "groupSlug": "github-actions-updates",
      "pinDigests": true
    },
    {
      "description": "Disable digest pinning for GitHub Actions uses-with dependencies",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "pinDigests": false
    }
  ]
}
